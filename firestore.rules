rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn()
        && exists(accountPath())
        && get(accountPath()).data.disabled != true;
    }

    function isOwner() {
      return hasAccess()
        && get(accountPath()).data.role == 'owner';
    }

    function validRole(role) {
      return role == 'owner' || role == 'staff';
    }

    // 帳號權限維持獨立控制。
    match /accounts/{uid} {
      allow read: if hasAccess();
      allow create: if isOwner()
        && validRole(request.resource.data.role)
        && request.resource.data.disabled == false;
      allow update: if isOwner()
        && validRole(request.resource.data.role)
        && (uid != request.auth.uid || request.resource.data.disabled == false);
      allow delete: if false;
    }

    // 除 accounts 外，所有應用資料共用同一套規則。
    // 一般資料可讀取 / 新增 / 修改；永久刪除只開放 orders 且僅限 owner。
    match /{collection}/{document=**} {
      allow read, create, update: if collection != 'accounts' && hasAccess();
      allow delete: if collection == 'orders' && isOwner();
    }
  }
}
