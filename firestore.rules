rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accountPath() { return /databases/$(database)/documents/accounts/$(request.auth.uid); }
    function hasAccess() { return signedIn() && exists(accountPath()) && get(accountPath()).data.disabled != true; }
    function role() { return hasAccess() ? get(accountPath()).data.role : null; }
    function isOwner() { return role() == 'owner'; }
    function isAdmin() { return role() == 'owner' || role() == 'staff'; }
    function isHelper() { return role() == 'helper'; }
    function validRole(value) { return value == 'owner' || value == 'staff' || value == 'helper'; }

    match /accounts/{uid} {
      allow read: if isAdmin() || (hasAccess() && uid == request.auth.uid);
      allow create: if isOwner() && validRole(request.resource.data.role) && request.resource.data.disabled == false;
      allow update: if isOwner() && validRole(request.resource.data.role) && (uid != request.auth.uid || request.resource.data.disabled == false);
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if isAdmin() || isHelper();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /helper_catalog/{id} {
      allow read: if isAdmin() || isHelper();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /helper_entries/{id} {
      allow read: if isAdmin() || (isHelper() && resource.data.created_by_uid == request.auth.uid);
      allow create: if isHelper()
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.status in ['pending','converted']
        && request.resource.data.keys().hasOnly([
          'created_by_uid','created_by_name','customer_id','customer_name','customer_phone_last2',
          'items','total_amount','is_virtual','note','status','converted_order_id','converted_at',
          'direct_order','created_at','updated_at'
        ]);
      allow update: if isAdmin() || (isHelper()
        && resource.data.created_by_uid == request.auth.uid
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status in ['pending','cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'customer_id','customer_name','customer_phone_last2','items','total_amount','is_virtual','note','status','updated_at'
            ]))
          ||
          (resource.data.status == 'converted'
            && resource.data.direct_order == true
            && request.resource.data.status == 'converted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'items','total_amount','is_virtual','note','updated_at'
            ]))
        ));
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if isAdmin() || isHelper();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin() || (isHelper()
        && resource.data.source == 'helper'
        && resource.data.created_by_uid == request.auth.uid);
      allow create: if isAdmin() || (isHelper()
        && request.resource.data.source == 'helper'
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.payment_status == 'unpaid'
        && (
          (request.resource.data.fulfillment_type == 'stock' && request.resource.data.payable_status == 'paid')
          ||
          (request.resource.data.fulfillment_type != 'stock' && request.resource.data.payable_status == 'unpaid')
        )
        && request.resource.data.helper_entry_id is string);
      allow update: if isAdmin() || (isHelper()
        && resource.data.source == 'helper'
        && resource.data.created_by_uid == request.auth.uid
        && resource.data.status == 'pending'
        && resource.data.archived != true
        && request.resource.data.source == resource.data.source
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items','total_amount','note','is_virtual','updated_at'
        ]));
      allow delete: if isOwner();
    }

    match /stock_inventory/{id} {
      allow read: if isAdmin() || isHelper();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isHelper()
        && request.resource.data.product_id == resource.data.product_id
        && request.resource.data.available_qty is number
        && request.resource.data.available_qty >= 0
        && request.resource.data.available_qty <= resource.data.available_qty
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available_qty','updated_at']));
      allow delete: if false;
    }

    match /stock_purchase_extras/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /expenses/{id} { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /supplier_payments/{id} { allow read, create, update: if isAdmin(); allow delete: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
