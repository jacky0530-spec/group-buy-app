# Firebase Web App 設定
# 來源：Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx

# Vercel Server Environment Variables（只放 Vercel，不要加 VITE_ 前綴）
# Neon pooled connection string，例如 postgresql://...@...-pooler.../neondb?sslmode=require
DATABASE_URL=your_neon_pooled_connection_string
# 用於後端驗證 Firebase ID Token；應與 VITE_FIREBASE_PROJECT_ID 相同
FIREBASE_PROJECT_ID=your_project_id
